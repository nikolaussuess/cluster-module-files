#%Module

set name        "openmpi"
set version     "5.0.3"
set long_name   "${name} (${version})"
set myuser      $::env(USER)
set myhome      $::env(HOME)
set root        "/opt/${name}/${version}"
set shell       [module-info shelltype]

proc ModulesHelp { } {
    upvar name      name
    upvar version   version
    puts stderr "Adds ${name} version {version} to your environment variables.\n"
}

module-whatis "load ${long_name}\n"

prepend-path PATH "${root}/bin"
prepend-path MANPATH "${root}/share/man"
setenv MPI_HOME "${root}"
setenv MPI_RUN "${root}/bin/mpirun"
prepend-path LD_LIBRARY_PATH ${root}/lib
prepend-path LD_RUN_PATH ${root}/lib
